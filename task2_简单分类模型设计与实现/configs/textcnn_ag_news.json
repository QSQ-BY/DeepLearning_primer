{
  "experiment_name": "textcnn_baseline",
  "seed": 42,
  "data": {
    "dataset_name": "fancyzhx/ag_news",
    "cache_dir": "../.build/task2/data",
    "val_ratio": 0.1,
    "max_vocab_size": 50000,
    "min_freq": 2,
    "max_length": 256,
    "pad_id": 0,
    "unk_id": 1
  },
  "model": {
    "name": "textcnn",
    "embed_dim": 128,
    "num_filters": 128,
    "kernel_sizes": [3, 4, 5],
    "dropout": 0.5,
    "num_classes": 4
  },
  "training": {
    "batch_size": 64,
    "epochs": 10,
    "learning_rate": 0.001,
    "weight_decay": 0.0,
    "device": "auto",
    "num_workers": 0,
    "scheduler": {
      "name": "none"
    }
  },
  "output": {
    "run_dir": "../.build/task2/runs/textcnn_baseline",
    "checkpoint_name": "best.pt",
    "log_name": "metrics.csv"
  }
}
